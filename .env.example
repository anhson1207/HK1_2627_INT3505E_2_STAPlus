# ==============================================================================
# CRM STAPlus - Environment Variables Template
# Copy this file to .env and provide your own values.
# NEVER commit real credentials, passwords, or cryptographic keys to Git!
# ==============================================================================

# Database Credentials
DB_URL=jdbc:postgresql://localhost:5432/crm_db
CHAT_DB_URL=jdbc:postgresql://localhost:5432/chat_db
DB_USERNAME=your_database_username
DB_PASSWORD=your_secure_database_password

# Cryptographic Keys (Mandatory - min 32 chars for JWT, min 16 chars for Internal Key)
# Generate using: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARS_LONG
INTERNAL_SERVICE_KEY=CHANGE_ME_TO_A_SECURE_RANDOM_INTERNAL_KEY_MIN_16_CHARS

# JWT Expiration Settings
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Service Ports & Networking
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
CHAT_SERVICE_PORT=8086
AUTH_SERVICE_URL=http://localhost:8081
CHAT_SERVICE_URL=http://localhost:8086

# WebSocket Configuration
CHAT_WS_TICKET_TTL=60
CHAT_UPLOAD_DIR=uploads/chat

# Initial System Administrator Seed
ADMIN_EMAIL=admin@crm.local
ADMIN_PASSWORD=YourStrongAdminPassword123!
ADMIN_USERNAME=admin

# Email Notification Service (SMTP)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=notifications@yourdomain.com
MAIL_PASSWORD=your_email_smtp_app_password

# Frontend Environment Variables
VITE_API_URL=http://localhost:8080
VITE_AUTH_API_BASE_URL=http://localhost:8081
VITE_WS_URL=ws://localhost:8086/ws/chat

